APP_NAME=triovexa
APP_ENV=local
DEPLOYMENT_MODE=local-demo
HTTP_HOST=127.0.0.1
HTTP_PORT=8080
BROWSER_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
WEBHOOK_RATE_LIMIT=60
WEBHOOK_RATE_WINDOW=1m
DATABASE_URL=postgres://postgres:postgres@localhost:5433/triovexa?sslmode=disable
DOCS_ROOT=docs
DEMO_SERVICE_BASE_URL=http://localhost:8090
WORKLOAD_CONTROL_BASE_URL=
WORKLOAD_CONTROL_TOKEN=
REDIS_ADDRESS=
REASONING_MODE=llm
OBSERVABILITY_MODE=demo
# Leave this empty to use the per-user default config directory.
LOCAL_OBSERVABILITY_PROFILE_PATH=
ACTION_EXECUTION_TIMEOUT=5s
ACTION_EXECUTION_COOLDOWN=1m
ACTION_EXECUTION_RETRIES=1
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=30s
HTTP_SHUTDOWN_TIMEOUT=10s
LOG_LEVEL=info
SESSION_SECURE=false
SESSION_TTL=12h
GRAFANA_WEBHOOK_SECRET=
KILL_SWITCH_ENABLED=false
DEMO_SERVICE_PORT=8090

# Real provider integrations
GRAFANA_BASE_URL=
GRAFANA_API_TOKEN=
GRAFANA_METRICS_DATASOURCE_UID=grafanacloud-prom
GRAFANA_LOGS_DATASOURCE_UID=grafanacloud-logs
GRAFANA_QUERY_LOOKBACK=15m

# Example query templates. Adjust these to your telemetry schema before switching OBSERVABILITY_MODE=grafana.
GRAFANA_ERROR_RATE_QUERY=
GRAFANA_LATENCY_QUERY=
GRAFANA_QUEUE_QUERY=
GRAFANA_REPLICA_QUERY=
GRAFANA_LOGS_QUERY=
GRAFANA_DEPLOY_LOGS_QUERY=

# Direct monitoring endpoints shown on the Connections page.
PROMETHEUS_BASE_URL=
ALERTMANAGER_BASE_URL=
LOKI_BASE_URL=

# OpenAI-compatible Chat Completions configuration.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_JSON_MODE=true
LLM_TIMEOUT=60s
# Comma-separated host allowlist for internal mode. Leave empty in local demo.
LLM_ALLOW_HOSTS=

# Optional base64-encoded 32-byte key for internal deployments. When unset,
# Triovexa creates a local key at CREDENTIAL_KEY_PATH.
CREDENTIAL_KEY_PATH=
CREDENTIAL_ENCRYPTION_KEY=
