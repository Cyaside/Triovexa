APP_NAME=triovexa
APP_ENV=local
HTTP_PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/triovexa?sslmode=disable
DOCS_ROOT=docs
DEMO_SERVICE_BASE_URL=http://localhost:8090
REASONING_MODE=heuristic
OBSERVABILITY_MODE=demo
# Leave this empty to use the per-user default config directory.
LOCAL_OBSERVABILITY_PROFILE_PATH=
ACTION_EXECUTION_TIMEOUT=5s
ACTION_EXECUTION_COOLDOWN=1m
ACTION_EXECUTION_RETRIES=1
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=30s
HTTP_SHUTDOWN_TIMEOUT=10s
LOG_LEVEL=info
KILL_SWITCH_ENABLED=false
DEMO_SERVICE_PORT=8090

# Real provider integrations
GRAFANA_BASE_URL=
GRAFANA_API_TOKEN=
GRAFANA_WEBHOOK_SECRET=
GRAFANA_METRICS_DATASOURCE_UID=grafanacloud-prom
GRAFANA_LOGS_DATASOURCE_UID=grafanacloud-logs
GRAFANA_QUERY_LOOKBACK=15m

# Example query templates. Adjust these to your telemetry schema before switching OBSERVABILITY_MODE=grafana.
GRAFANA_ERROR_RATE_QUERY=
GRAFANA_LATENCY_QUERY=
GRAFANA_QUEUE_QUERY=
GRAFANA_REPLICA_QUERY=
GRAFANA_LOGS_QUERY=
GRAFANA_DEPLOY_LOGS_QUERY=

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
